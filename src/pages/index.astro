---
import '../styles/global.css'
---

<html lang="en">
    <head>
        <title>K1R4FN</title>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" href="/favicon.ico">
        <script type="module" src="/src/scripts/modelLoader.js" defer></script>
        <style>
            body {
                margin: 0;
                background-color: #f0f0f0;
                padding: 0;
                display: flex;
                flex-direction: column;
                align-items: center;
            }
            h1 {
                margin-top: 1rem;
                font-size: 2rem;
                text-align: center;
            }
            canvas {
                width: 100vw;
                height: 100vh;
                display: block;
            }
            #scroll-text {
                position: absolute;
                top: 50%;
                left: 60%;
                transform: translateY(-50%);
                font-size: 1.5rem;
                opacity: 0;
                transition: opacity 0.5s ease, transform 0.5s ease;
            }
        </style>
    </head>
    <body>
        <h1>La skin favorita de kira</h1>
        <canvas id="glow-canvas"></canvas>
        <div id="scroll-text">¡Descubre la Glow!</div>
    </body>
</html>
