---
import '../styles/global.css'
---

<html lang="en">
    <head>
        <title>K1R4FN</title>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" href="/favicon.ico">
        <script type="module" src="/src/scripts/modelLoader.js" defer></script>
        <style>
            body {
                margin: 0;
                background-color: #0d0d0d;
                color: #f5f5f5;
                padding: 0;
                display: flex;
                flex-direction: column;
                align-items: center;
            }
            canvas {
                width: 100vw;
                height: 100vh;
                display: block;
            }
            #scroll-text {
                position: absolute;
                top: 50%;
                left: 60%;
                transform: translateY(-50%);
                font-size: 1.5rem;
                opacity: 0;
                color: #ffffff;
                transition: opacity 0.5s ease, transform 0.5s ease;
            }
            nav {
                position: fixed;
                top: 0;
                width: 100%;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 10px 0;
                background: rgba(255, 255, 255, 0.1);
                backdrop-filter: blur(10px);
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
                z-index: 1000;
            }
            nav a {
                margin: 0 20px;
                text-decoration: none;
                font-size: 1rem;
                color: #f5f5f5;
                font-weight: 500;
                transition: color 0.3s ease;
            }
            nav a:hover {
                color: #007aff;
            }
        </style>
    </head>
    <body>
        <nav>
            <a href="/test">test</a>
            <a href="/test">test</a>
        </nav>
        <canvas id="glow-canvas"></canvas>
        <div id="scroll-text">¡Descubre la Glow!</div>
    </body>
</html>
